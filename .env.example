# Host port the shop is published on
HAMAZON_PORT=

# Password players enter once to open the shop
HAMAZON_SHOP_PASSWORD=

# Random string of at least 32 characters, e.g. from: openssl rand -hex 32
HAMAZON_SESSION_SECRET=

# Discord webhook for order notifications (Server Settings > Integrations > Webhooks)
HAMAZON_DISCORD_WEBHOOK_URL=

# Public URL of the shop, used for admin links in Discord messages (optional)
HAMAZON_PUBLIC_URL=

# Set to true when running behind a reverse proxy that sets X-Forwarded-For
HAMAZON_TRUST_PROXY=false

# Floodgate username prefix for Bedrock players
HAMAZON_FLOODGATE_PREFIX=.

# Minecraft version whose textures and font are downloaded and shown
HAMAZON_MC_VERSION=26.2
